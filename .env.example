# ─────────────────────────────────────────────────────────────
# «Я Онлайн» — переменные окружения фронтенда.
# Все переменные с префиксом VITE_ вшиваются в бандл НА ЭТАПЕ СБОРКИ,
# поэтому после их изменения нужно пересобрать проект (npm run build).
# Секретов здесь быть не должно: значения видны в браузере.
# ─────────────────────────────────────────────────────────────

# Базовый адрес REST API (Node.js backend + PostgreSQL).
# Локально: http://localhost:4000/api
# Прод (Nginx проксирует /api на backend): /api
VITE_API_URL=/api

# Адрес WebSocket-сервера для чата (без завершающего слэша).
# Локально: ws://localhost:4000/ws
# Прод: wss://example.com/ws
# Пусто -> realtime работает в мок-режиме (без соединения).
VITE_WS_URL=

# Отображаемое имя приложения (заголовки, метаданные).
VITE_APP_NAME=Я Онлайн
