# ─────────────────────────────────────────────────────────────
# «Я Онлайн» — переменные backend. Файл .env НЕ коммитится.
# Права на файл: chmod 600, владелец — пользователь deploy.
# ─────────────────────────────────────────────────────────────

# Окружение: development | production
NODE_ENV=production

# Порт, который слушает Node.js. Наружу не публикуется —
# Nginx проксирует на 127.0.0.1:PORT.
PORT=4000
HOST=127.0.0.1

# Подключение к PostgreSQL (локальный сокет/loopback).
DATABASE_URL=postgres://ya_online:СМЕНИТЕ_ПАРОЛЬ@127.0.0.1:5432/ya_online
# Максимум соединений в пуле (на один процесс PM2!).
PG_POOL_MAX=10

# Секреты JWT. Сгенерировать: openssl rand -base64 48
JWT_ACCESS_SECRET=СМЕНИТЕ_МЕНЯ
JWT_REFRESH_SECRET=СМЕНИТЕ_МЕНЯ_ТОЖЕ
# Время жизни токенов.
ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# Разрешённые origin'ы фронтенда (через запятую).
# В проде фронтенд и API на одном домене, поэтому обычно достаточно одного.
CORS_ORIGINS=https://example.com

# Куда складывать загруженные медиа и селфи верификации.
# Каталог селфи НЕ должен раздаваться Nginx.
MEDIA_DIR=/var/lib/ya-online/media
VERIFICATION_DIR=/var/lib/ya-online/verification

# Сколько дней аккаунт можно восстановить после удаления.
ACCOUNT_RESTORE_DAYS=14

# Сколько совпадений в дневной подборке.
DAILY_MATCH_LIMIT=5
