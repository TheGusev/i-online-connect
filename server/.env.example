# ─────────────────────────────────────────────────────────────
# «Я Онлайн» — переменные backend. Файл .env НЕ коммитится.
# Права на файл: chmod 600, владелец — пользователь deploy.
# ─────────────────────────────────────────────────────────────

# Окружение: development | production
NODE_ENV=production

# Порт, который слушает Node.js. Наружу не публикуется —
# Nginx проксирует на 127.0.0.1:PORT.
PORT=4000
HOST=127.0.0.1

# Подключение к PostgreSQL (локальный сокет/loopback).
DATABASE_URL=postgres://ya_online:СМЕНИТЕ_ПАРОЛЬ@127.0.0.1:5432/ya_online
# Максимум соединений в пуле (на один процесс PM2!).
PG_POOL_MAX=10

# Секреты JWT. Сгенерировать: openssl rand -base64 48
JWT_ACCESS_SECRET=СМЕНИТЕ_МЕНЯ
JWT_REFRESH_SECRET=СМЕНИТЕ_МЕНЯ_ТОЖЕ
# Время жизни токенов.
ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# Разрешённые origin'ы фронтенда (через запятую).
# В проде фронтенд и API на одном домене, поэтому обычно достаточно одного.
CORS_ORIGINS=https://example.com

# Куда складывать загруженные медиа и селфи верификации.
# Каталог селфи НЕ должен раздаваться Nginx.
MEDIA_DIR=/var/lib/ya-online/media
VERIFICATION_DIR=/var/lib/ya-online/verification

# Сколько дней аккаунт можно восстановить после удаления.
ACCOUNT_RESTORE_DAYS=14

# Сколько совпадений в дневной подборке.
DAILY_MATCH_LIMIT=5

# ── Автосверка лица на верификации ───────────────────────────────────────────
# Адрес OpenAI-совместимого API модели зрения и ключ к нему.
# Пока AI_API_KEY пуст, заявки не отклоняются автоматически,
# а попадают в ручную очередь модерации.
AI_API_URL=https://ai.gateway.lovable.dev/v1
AI_API_KEY=
AI_VISION_MODEL=openai/gpt-5.6-sol
# Порог уверенности (50-100), с которого доверяем автоматическому решению.
FACE_MATCH_MIN_CONFIDENCE=80

# Путь к ffmpeg (нужен для нарезки кадров из видео-селфи).
FFMPEG_PATH=ffmpeg

# Публичный адрес MEDIA_DIR: относительный путь при общем домене с сайтом,
# либо абсолютный URL, если API на отдельном домене.
# Каталог раздаёт сам backend; в проде тот же путь лучше отдать через Nginx.
MEDIA_BASE_URL=/media

# ── Админка ──────────────────────────────────────────────────────────────────
# Файл аудита доступа к /api/admin/* (только метаданные запросов).
ADMIN_LOG_FILE=logs/admin-audit.log

# ─── Вход в админку (второй фактор) ──────────────────────────────────────────
# Отдельный ключ подписи админской сессии. Пусто — вход в админку выключен.
#   openssl rand -base64 48
JWT_ADMIN_SECRET=
# Срок жизни админской сессии. Не обновляется: истекла — входить заново.
ADMIN_SESSION_TTL=2h
# Ключ шифрования TOTP-секретов (AES-256-GCM), минимум 32 символа.
# Потеря ключа = потеря второго фактора: привязку придётся делать заново.
#   openssl rand -base64 48
TOTP_ENCRYPTION_KEY=

# ─── Redis: общие счётчики rate limit ────────────────────────────────────────
# Пусто — счётчики живут в памяти процесса и сбрасываются при перезапуске.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── Капча (Yandex SmartCaptcha) ─────────────────────────────────────────────
# Серверный (секретный) ключ. Пусто — проверка выключена.
YANDEX_CAPTCHA_SECRET=

# Журнал подозрительной активности: все ответы 429 и 403.
ABUSE_LOG_FILE=logs/abuse.log
